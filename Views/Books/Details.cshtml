@model BookDetailsModel
@inject ReadingListService Reading
@{
 var book=Model.Book;
 ViewData["Title"]=book.Title;
 var saved=Reading.Contains(book.Id);
 var hasSample=!string.IsNullOrWhiteSpace(book.SampleText);
 var illustrative=book.Isbn.StartsWith("DEMO-") || book.Isbn.StartsWith("CAT-");
}
<nav class="breadcrumb-custom" aria-label="Đường dẫn"><a href="/">Trang chủ</a> / <a href="/Home/Index?category=@book.CategoryId#catalog">@book.Category.Name</a> / <span>@book.Title</span></nav>
<section class="detail-grid">
 <div class="detail-visual"><div class="detail-cover"><button type="button" class="cover-zoom" data-cover-open aria-label="Phóng to bìa @book.Title"><img src="@book.ImagePath" alt="Bìa @book.Title" width="240" height="350" /><span>Phóng to bìa ⤢</span></button></div>@if(illustrative){<p class="cover-caption">Bìa thiết kế để minh họa giao diện.</p>}@if(hasSample){<a class="btn btn-outline-forest sample-cover-link" asp-action="Sample" asp-route-id="@book.Id">Mở trang đọc thử ↗</a>}</div>
 <div class="detail-purchase"><span class="eyebrow">@book.Category.Name · SÁCH GIẤY</span><h1>@book.Title</h1><p class="byline">Tác giả: <a href="/Home/Index?author=@book.AuthorId#catalog">@book.Author.Name</a></p><p class="byline">Nhà xuất bản: <a href="/Home/Index?publisher=@book.PublisherId#catalog">@book.Publisher.Name</a></p>
  @if(Model.Sold > 0){<p class="sold-count">Đã bán @Model.Sold cuốn qua các đơn đã giao</p>}
  <div class="price-panel"><div class="detail-price"><strong>@book.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</strong>@if(book.ListPrice > book.Price){<del>@book.ListPrice.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</del><span class="price-badge">-@Math.Round((1 - book.Price / book.ListPrice) * 100)%</span>}</div>@if(book.ListPrice > book.Price){<span class="saving">Tiết kiệm @((book.ListPrice - book.Price).ToString("N0", CultureInfo.GetCultureInfo("vi-VN")))đ so với giá tham khảo</span>}</div>
  <p class="stock @(book.Stock <= 0 ? "out-of-stock" : "")">@(book.Stock > 0 ? $"● Còn hàng · {book.Stock} cuốn" : "○ Tạm hết hàng")</p>
  <form id="detail-buy-form" data-cart-add class="buy-form" asp-controller="Cart" asp-action="Add" method="post"><input name="id" value="@book.Id" type="hidden" /><label for="qty">Số lượng</label><div class="quantity-stepper"><button type="button" data-quantity-step="-1" aria-label="Giảm số lượng">−</button><input id="qty" name="quantity" type="number" value="1" min="1" max="@Math.Min(20,Math.Max(1,book.Stock))" aria-label="Số lượng sách" /><button type="button" data-quantity-step="1" aria-label="Tăng số lượng">+</button></div><div class="purchase-actions"><button class="btn btn-outline-forest" disabled="@(book.Stock <= 0)">Thêm vào giỏ hàng</button><button class="btn btn-forest" name="proceed" value="checkout" disabled="@(book.Stock <= 0)">Mua ngay →</button></div></form>
  <div class="detail-secondary-actions"><form data-reading-toggle data-book-id="@book.Id" asp-action="ToggleFavorite" method="post"><input type="hidden" name="id" value="@book.Id" /><input type="hidden" name="returnUrl" value="/Books/Details/@book.Id" /><button type="submit" class="text-button">@(saved ? "♥ Đã lưu yêu thích" : "♡ Lưu vào yêu thích")</button></form><button type="button" class="text-button" data-copy-link>↗ Sao chép liên kết</button><span role="status" data-copy-status></span></div>
  <div class="purchase-trust"><span>✓ Giá kiểm tra khi đặt</span><span>✓ Thanh toán COD</span><span>✓ Theo dõi đơn trong tài khoản</span></div><div class="delivery-box"><div><b>Giao hàng tận nơi</b><p>Phí 30.000đ/đơn · Miễn phí từ 300.000đ</p></div><div><b>Thanh toán khi nhận hàng</b><p>Kiểm tra thông tin đơn trước khi xác nhận</p></div><a href="/Home/Policy">Xem chính sách giao hàng & đổi trả →</a></div>
  @if(illustrative){<p class="demo-note">Giá và tồn kho minh họa để thử nghiệm đặt hàng.</p>}
 </div>
</section>
<div class="mobile-purchase-bar"><div><small>Giá bán</small><strong>@book.Price.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))đ</strong></div><button type="submit" form="detail-buy-form" name="proceed" value="checkout" class="btn btn-forest" disabled="@(book.Stock <= 0)">Mua ngay →</button></div>
<nav class="detail-anchor-nav" aria-label="Thông tin cuốn sách"><a href="#description">Giới thiệu</a><a href="#specifications">Thông tin chi tiết</a>@if(hasSample){<a asp-action="Sample" asp-route-id="@book.Id">Đọc thử</a>}<a href="#related">Sách cùng thể loại</a></nav>
<div class="detail-info"><section id="description"><h3>Giới thiệu sách</h3><div class="description-content" data-description id="book-description"><p class="pre-line">@book.Description</p></div><button type="button" class="description-toggle text-button" data-description-toggle aria-controls="book-description" hidden aria-expanded="false">Xem thêm giới thiệu ↓</button>@if(!hasSample){<p class="muted">Chưa có trang đọc thử cho cuốn sách này.</p>}
 @if(Uri.TryCreate(book.SourceUrl,UriKind.Absolute,out var source) && (source.Scheme == "https" || source.Scheme == "http")){<a href="@book.SourceUrl" target="_blank" rel="noopener noreferrer" class="source-link">Nguồn thông tin về ấn bản ↗</a>}
 </section><section id="specifications"><h3>Thông tin chi tiết</h3><table class="table"><tbody><tr><th scope="row">Mã sản phẩm</th><td>@book.Isbn@if(illustrative){<small class="spec-help">Mã nội bộ, không phải ISBN</small>}</td></tr><tr><th scope="row">Tác giả</th><td>@book.Author.Name</td></tr>@if(!string.IsNullOrWhiteSpace(book.Translator)){<tr><th scope="row">Dịch giả</th><td>@book.Translator</td></tr>}<tr><th scope="row">Nhà xuất bản</th><td>@book.Publisher.Name</td></tr><tr><th scope="row">Năm ấn bản</th><td>@book.Year</td></tr><tr><th scope="row">Số trang</th><td>@book.Pages</td></tr><tr><th scope="row">Ngôn ngữ</th><td>@book.Language</td></tr><tr><th scope="row">Hình thức</th><td>@book.Binding</td></tr><tr><th scope="row">Kích thước</th><td>@(string.IsNullOrWhiteSpace(book.Dimensions) ? "Đang cập nhật" : book.Dimensions)</td></tr></tbody></table></section></div>
<section id="related" class="shelf-section"><div class="section-heading"><div><span class="eyebrow">CÙNG KHÁM PHÁ THÊM</span><h2>Có thể bạn cũng thích</h2></div><a href="/Home/Index?category=@book.CategoryId#catalog">Xem cùng thể loại →</a></div>@if(Model.Related.Count > 0){<div class="book-grid shelf-grid">@foreach(var b in Model.Related){<partial name="_BookCard" model="b" />}</div>}else{<p class="muted">Chưa có sách khác trong thể loại này.</p>}</section>

<dialog class="cover-dialog" data-cover-dialog aria-label="Bìa sách @book.Title"><button type="button" data-cover-close class="modal-close">Đóng ×</button><img src="@book.ImagePath" alt="Bìa @book.Title" /><p>@book.Title</p>@if(illustrative){<small>Bìa thiết kế minh họa</small>}</dialog>
