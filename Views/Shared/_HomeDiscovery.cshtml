@model CatalogModel
@if(Model.NewBooks.Count>0){<section id="new-books" class="home-section"><div class="section-heading"><div><span class="eyebrow">THÊM VÀO TỦ SÁCH HÔM NAY</span><h2>Vừa bổ sung vào tủ sách</h2></div><a href="/Home/Index?sort=new#catalog">Khám phá thêm →</a></div><div class="book-grid shelf-grid">@foreach(var b in Model.NewBooks){<partial name="_BookCard" model="b" />}</div></section>}
@if(Model.ThemeShelves.Count>0){<section id="theme-books" class="home-section theme-section"><div class="section-heading"><div><span class="eyebrow">MỖI SỞ THÍCH, MỘT TỦ SÁCH</span><h2>Chọn sách theo gu của bạn</h2></div><a href="#categories">Tất cả thể loại →</a></div><nav class="home-tabs" data-shelf-tabs aria-label="Tủ sách theo thể loại">@foreach(var shelf in Model.ThemeShelves){<a id="tab-theme-@shelf.CategoryId" href="#theme-@shelf.CategoryId" data-shelf-tab="theme-@shelf.CategoryId">@shelf.Name</a>}</nav>@foreach(var shelf in Model.ThemeShelves){<div id="theme-@shelf.CategoryId" class="theme-panel" data-shelf-panel><div class="theme-panel-heading"><h3>@shelf.Name</h3><a href="/Home/Index?category=@shelf.CategoryId#catalog">Xem cả tủ sách →</a></div><div class="book-grid shelf-grid">@foreach(var b in shelf.Books){<partial name="_BookCard" model="b" />}</div></div>}</section>}
<aside class="sample-callout"><div><span class="eyebrow">ĐỌC TRƯỚC KHI CHỌN</span><h3>Bạn muốn xem vài trang mẫu?</h3><p>Lọc sách có nội dung đọc thử và mở trang mẫu ngay trong chi tiết.</p></div><a href="/Home/Index?hasSample=true#catalog" class="btn btn-outline-forest">Khám phá sách đọc thử →</a></aside>
