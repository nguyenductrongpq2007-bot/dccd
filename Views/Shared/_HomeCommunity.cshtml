@model CatalogModel
@if(Model.FeaturedAuthors.Count>0){<section class="home-section"><div class="section-heading"><div><span class="eyebrow">ĐI THEO MỘT GIỌNG KỂ</span><h2>Khám phá theo tác giả</h2></div><a href="#catalog">Tìm tác giả trong bộ lọc →</a></div><div class="spotlight-grid">@foreach(var a in Model.FeaturedAuthors){<a class="author-spotlight" href="/Home/Index?author=@a.Id#catalog"><span class="author-avatar" aria-hidden="true">@(a.Name.Length>0?a.Name[..1]:"M")</span><strong>@a.Name</strong><small>@a.BookCount đầu sách trong tủ</small><span class="spotlight-link">Xem sách →</span></a>}</div></section>}
<section class="home-faq"><div><span class="eyebrow">MUA SÁCH THẬT DỄ</span><h2>Bạn đang băn khoăn?</h2><p>Tìm nhanh câu trả lời trước khi chọn sách.</p><a href="/Home/Support" class="btn btn-outline-forest">Trung tâm hướng dẫn →</a></div><div><details><summary>Phí giao hàng được tính thế nào?</summary><p>30.000đ mỗi đơn. Đơn có tiền sách từ 300.000đ được miễn phí giao hàng. Tổng tiền hiển thị ở giỏ và trước khi đặt đơn.</p></details><details><summary>Có thể đọc thử trước khi mua không?</summary><p>Chọn bộ lọc Có trang đọc thử. Mở sách rồi nhấn Đọc thử để xem nội dung mẫu đã có trong hệ thống.</p></details><details><summary>Tôi thanh toán bằng cách nào?</summary><p>Website hiện hỗ trợ thanh toán khi nhận hàng (COD). Chưa có thanh toán bằng thẻ hoặc ví điện tử.</p></details><details><summary>Làm sao xem lại đơn đã đặt?</summary><p>Đăng nhập đúng tài khoản, mở <a href="/Orders">Đơn hàng của tôi</a>. Mã đơn, thông tin nhận hàng và trạng thái được hiển thị tại đó.</p></details></div></section>
