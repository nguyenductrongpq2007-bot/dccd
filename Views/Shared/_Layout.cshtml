@inject CartService Cart
@inject ReadingListService Reading
<!doctype html>
<html lang="vi">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width,initial-scale=1" />
 <meta name="color-scheme" content="light" />
 <meta name="description" content="Mộc Books: khám phá sách giấy, lọc theo tác giả và nhà xuất bản, đọc thử trước khi chọn." />
 <title>@ViewData["Title"] · Mộc Books</title>
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
 <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/experience.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/home-rich.css" asp-append-version="true" />
 <link rel="stylesheet" href="~/css/shop-polish.css" asp-append-version="true" />
</head>
<body>
 <a href="#main-content" class="skip-link">Đi đến nội dung</a>
 <div class="header-shell">
  <header class="container header">
   <a class="brand" asp-controller="Home" asp-action="Index"><b>mộc<span>books</span></b><small>NHÀ SÁCH TRỰC TUYẾN</small></a>
   <div class="search-wrap">
    <form class="search" asp-controller="Home" asp-action="Index" method="get" role="search">
     <input id="site-search" name="q" type="search" maxlength="120" aria-label="Tìm tên sách, tác giả hoặc mã sách" placeholder="Bạn muốn đọc cuốn sách nào?" value="@Context.Request.Query["q"]" list="book-suggestions" autocomplete="off" />
     <datalist id="book-suggestions"></datalist>
     <button type="submit">Tìm kiếm</button>
    </form>
    <div class="search-trends"><a href="/Home/Index?q=Nhà+giả+kim">Nhà giả kim</a><a href="/Home/Index?maxPrice=100000#catalog">Sách dưới 100k</a><a href="/Home/Index?hasSample=true#catalog">Có trang đọc thử</a></div>
   </div>
   <div class="account-links">
    <a class="favorites-link" asp-controller="Books" asp-action="Favorites">♡ Yêu thích <b data-favorite-count>@Reading.Favorites.Count</b></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
     <details class="account-menu"><summary>Tài khoản</summary><div class="account-dropdown"><strong>@User.Identity.Name</strong><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a><a asp-controller="Books" asp-action="Recent">Sách vừa xem</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button">Đăng xuất</button></form></div></details>
    }
    else
    {
     <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
    }
    <a class="cart-link" asp-controller="Cart" asp-action="Index">Giỏ hàng <b data-cart-count>@Cart.Count</b></a>
   </div>
  </header>
 </div>
 <nav class="navline" aria-label="Điều hướng chính"><div class="container">
  <a href="/#categories">☰ Danh mục sách</a><a href="/Home/Index?sort=new#catalog">Sách mới</a><a href="/Home/Index?sort=discount#catalog">Ưu đãi sách</a><a href="/Home/Index?sort=bestseller#catalog">Sách bán chạy</a><a asp-controller="Books" asp-action="Recent">Vừa xem</a><a asp-controller="Home" asp-action="Policy">Giao hàng & đổi trả</a>
  @if(User.IsInRole("Admin")){<a class="admin-link" asp-controller="Admin" asp-action="Index">Quản trị</a>}
 </div></nav>
 <main id="main-content" class="container main">
  @if(TempData["Success"] != null){<div class="alert alert-success" role="status">@TempData["Success"]</div>}
  @if(TempData["Error"] != null){<div class="alert alert-danger" role="alert">@TempData["Error"]</div>}
  @RenderBody()
 </main>
 <partial name="_StoreFooter" />
 <nav class="mobile-bottom-nav" aria-label="Điều hướng trên điện thoại">
  <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10l9-7 9 7v10H3z"/><path d="M9 20v-7h6v7"/></svg><small>Trang chủ</small></a>
  <a href="/#categories"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><small>Danh mục</small></a>
  <a href="/Books/Favorites"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 5.6a5.5 5.5 0 0 0-8.6 1 5.5 5.5 0 0 0-8.6-1C-1 10 5 15 12 21c7-6 13-11 8.6-15.4z"/></svg><small>Yêu thích</small></a>
  <a class="mobile-cart" href="/Cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h3l3 12h11l3-9H6"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg><b data-cart-count>@Cart.Count</b><small>Giỏ hàng</small></a>
  <a href="@(User.Identity?.IsAuthenticated==true ? "/Orders" : "/Account/Login")"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><small>Tài khoản</small></a>
 </nav>
 <div class="cart-feedback" hidden role="status" aria-live="polite"><span data-cart-feedback-text></span><a href="/Cart">Xem giỏ hàng →</a><button type="button" data-dismiss-feedback aria-label="Đóng thông báo">×</button></div>
 <button type="button" class="back-to-top" aria-label="Về đầu trang" hidden>↑</button>
 <script src="~/js/site.js" asp-append-version="true"></script>
 @await RenderSectionAsync("Scripts", required: false)
</body></html>
