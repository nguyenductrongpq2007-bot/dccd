@model CheckoutForm
@{ViewData["Title"]="Đặt hàng";var lines=(List<CartLine>)ViewBag.Lines;var subtotal=lines.Sum(x=>x.Total);var shipping=subtotal>=300000?0:30000;}
<nav class="shopping-steps" aria-label="Các bước đặt sách"><a href="/Cart"><b>1</b> Giỏ hàng</a><span class="current" aria-current="step"><b>2</b> Thông tin nhận sách</span><span><b>3</b> Hoàn tất</span></nav>
<div class="section-heading"><div><span class="eyebrow">CHỈ CÒN MỘT BƯỚC NỮA</span><h1>Hoàn tất đơn hàng</h1><p class="muted">Kiểm tra địa chỉ và tổng tiền trước khi xác nhận.</p></div><a href="/Cart">← Sửa giỏ hàng</a></div>
<div class="checkout-grid"><form method="post" class="panel checkout-form">
 <h4>Thông tin nhận sách</h4><div asp-validation-summary="All" class="text-danger validation-summary" role="alert"></div><input asp-for="Token" type="hidden" />
 @if(ViewBag.AddressPrefilled==true){<div class="address-prefill-note">Thông tin được điền từ đơn gần nhất. Bạn có thể chỉnh lại trước khi đặt.</div>}
 <div class="checkout-fields"><div><label asp-for="Recipient">Họ tên người nhận <span>*</span></label><input asp-for="Recipient" class="form-control" autocomplete="shipping name" required maxlength="100" placeholder="Nguyễn Văn An" /><span asp-validation-for="Recipient" class="field-error"></span></div><div><label asp-for="Phone">Số điện thoại <span>*</span></label><input asp-for="Phone" type="tel" inputmode="tel" class="form-control" autocomplete="shipping tel" required maxlength="12" placeholder="0901234567" /><span asp-validation-for="Phone" class="field-error"></span></div></div>
 <label asp-for="Address">Địa chỉ nhận sách <span>*</span></label><textarea asp-for="Address" class="form-control" autocomplete="shipping street-address" required minlength="10" maxlength="500" rows="3" placeholder="Số nhà, tên đường, phường/xã, tỉnh/thành"></textarea><span asp-validation-for="Address" class="field-error"></span><p class="input-help">Ghi đủ địa chỉ để cửa hàng liên hệ và giao đúng nơi.</p>
 <label asp-for="Note">Ghi chú giao hàng <small>Không bắt buộc</small></label><textarea asp-for="Note" class="form-control" rows="2" maxlength="1000" placeholder="Ví dụ: gọi điện trước khi giao"></textarea>
 <div class="payment-box"><span class="payment-icon" aria-hidden="true">✓</span><div><strong>Thanh toán khi nhận hàng (COD)</strong><p>Bạn thanh toán khi đơn hàng được giao. Phí giao hàng đã tính trong tổng tiền bên cạnh.</p></div></div>
 <button type="submit" class="btn btn-forest checkout-submit" data-submit-once>Đặt hàng · @((subtotal+shipping).ToString("N0",CultureInfo.GetCultureInfo("vi-VN")))đ</button><p class="muted mt-3">Khi đặt hàng, bạn đồng ý với <a href="/Home/Policy">chính sách mua hàng</a>.</p>
</form><aside class="summary checkout-summary"><h4>Đơn hàng của bạn <small>@lines.Sum(x=>x.Quantity) cuốn</small></h4>
 @foreach(var l in lines){<div class="checkout-book"><img src="@l.Book.ImagePath" alt="Bìa @l.Book.Title" width="44" height="64" /><div><strong>@l.Book.Title</strong><span>Số lượng: @l.Quantity</span></div><b>@l.Total.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))đ</b></div>}
 <hr /><p>Tạm tính <b>@subtotal.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))đ</b></p><p>Phí giao hàng <b>@(shipping==0?"Miễn phí":shipping.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+"đ")</b></p><p class="grand-total">Tổng thanh toán <b>@((subtotal+shipping).ToString("N0",CultureInfo.GetCultureInfo("vi-VN")))đ</b></p><p class="input-help">Giá và tồn kho được kiểm tra lại khi bạn xác nhận đặt hàng.</p>
</aside></div>
