@model List<Order>
@{ViewData["Title"]="Đơn hàng của tôi";}
<div class="section-heading"><div><span class="eyebrow">THEO DÕI NHỮNG CUỐN SÁCH ĐÃ CHỌN</span><h1>Đơn hàng của tôi</h1></div><a href="/#catalog">Tiếp tục mua sách →</a></div>
@if(Model.Count==0){<div class="empty"><span class="empty-icon">📦</span><h3>Bạn chưa có đơn hàng</h3><p>Tìm một cuốn sách bạn muốn mang về nhà.</p><a class="btn btn-forest" href="/#catalog">Khám phá tủ sách</a></div>}else{<div class="order-card-list">@foreach(var order in Model){<article class="customer-order-card"><header><strong>BS@(order.Id.ToString("D6"))</strong><span>@order.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span><b class="status">@order.Status</b></header><div class="order-book-names">@string.Join(" · ",order.OrderItems.Take(3).Select(x=>x.BookTitle))@(order.OrderItems.Count>3?" …":"")</div><footer><div><span>@order.OrderItems.Sum(x=>x.Quantity) cuốn</span><strong>@order.Total.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))đ</strong></div><a class="btn btn-outline-forest" asp-action="Details" asp-route-id="@order.Id">Xem chi tiết →</a></footer></article>}</div>}
