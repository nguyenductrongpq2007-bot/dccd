@model List<Book>
@{ViewData["Title"]="Quản lý sách";}<partial name="_AdminNav"/><div class="section-heading"><h1>Quản lý sách</h1><a class="btn btn-forest" href="/Admin/EditBook">+ Thêm sách</a></div><form method="get" class="search mb-3"><input name="q" placeholder="Tìm tên sách"/><button>Tìm</button></form><div class="table-responsive panel"><table class="table"><thead><tr><th>Sách</th><th>Thể loại</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><img class="thumb" src="@b.ImagePath" alt=""/> @b.Title</td><td>@b.Category.Name</td><td>@b.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</td><td>@b.Stock</td><td>@(b.IsActive?"Đang bán":"Ngừng bán")</td><td><a href="/Admin/EditBook/@b.Id">Sửa</a><form asp-action="DeleteBook" method="post" class="inline" data-confirm="Xóa sách chưa có đơn hàng; sách đã có đơn sẽ ngừng bán. Tiếp tục?"><input name="id" type="hidden" value="@b.Id"/><button class="text-button text-danger">Xóa</button></form></td></tr>}</tbody></table></div>
