@model List<User>
@{ViewData["Title"]="Quản lý người dùng";}<partial name="_AdminNav"/><h1>Quản lý người dùng</h1><div class="table-responsive panel"><table class="table"><thead><tr><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@u.Role</td><td>@(u.IsActive?"Hoạt động":"Đã khóa")</td><td>@if(u.Role!="Admin"){<form asp-action="ToggleUser" method="post" data-confirm="Thay đổi trạng thái tài khoản này?"><input name="id" value="@u.Id" type="hidden"/><button class="btn btn-sm btn-outline-forest">@(u.IsActive?"Khóa":"Mở khóa")</button></form>}</td></tr>}</tbody></table></div>
