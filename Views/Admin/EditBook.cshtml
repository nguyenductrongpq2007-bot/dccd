@model BookForm
@{ViewData["Title"]=Model.Id==0?"Thêm sách":"Sửa sách";}<partial name="_AdminNav"/><h1>@ViewData["Title"]</h1><form method="post" enctype="multipart/form-data" class="panel"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Id" type="hidden"/><div class="row"><div class="col-md-6"><label asp-for="Title">Tên sách</label><input asp-for="Title" class="form-control"/><label asp-for="Isbn">ISBN / Mã sách</label><input asp-for="Isbn" class="form-control"/><label asp-for="CategoryId">Thể loại</label><select asp-for="CategoryId" class="form-select">@foreach(Category c in ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select><label asp-for="AuthorId">Tác giả</label><select asp-for="AuthorId" class="form-select">@foreach(Author a in ViewBag.Authors){<option value="@a.Id">@a.Name</option>}</select><label asp-for="PublisherId">Nhà xuất bản</label><select asp-for="PublisherId" class="form-select">@foreach(Publisher p in ViewBag.Publishers){<option value="@p.Id">@p.Name</option>}</select><label asp-for="Description">Mô tả</label><textarea asp-for="Description" class="form-control" rows="6"></textarea></div><div class="col-md-6"><label asp-for="Price">Giá bán (VNĐ)</label><input asp-for="Price" type="number" class="form-control"/><label asp-for="ListPrice">Giá bìa (VNĐ)</label><input asp-for="ListPrice" type="number" class="form-control"/><label asp-for="Stock">Tồn kho</label><input asp-for="Stock" class="form-control"/><label asp-for="Pages">Số trang</label><input asp-for="Pages" class="form-control"/><label asp-for="Year">Năm xuất bản</label><input asp-for="Year" class="form-control"/><label asp-for="Language">Ngôn ngữ</label><input asp-for="Language" class="form-control" />
<label asp-for="Binding">Hình thức bìa</label><select asp-for="Binding" class="form-select"><option>Đang cập nhật</option><option>Bìa mềm</option><option>Bìa cứng</option><option>Bìa vải</option><option>Bìa da</option></select>
<label asp-for="Dimensions">Kích thước</label><input asp-for="Dimensions" class="form-control" placeholder="14 x 20.5 cm" />
<label asp-for="Translator">Dịch giả (nếu có)</label><input asp-for="Translator" class="form-control" />
<label asp-for="SourceUrl">Nguồn thông tin ấn bản (nếu có)</label><input asp-for="SourceUrl" type="url" class="form-control" placeholder="https://..." />
<label asp-for="Cover">Ảnh bìa JPEG / PNG (tối đa 5 MB)</label><input asp-for="Cover" type="file" accept="image/jpeg,image/png" class="form-control"/><label class="mt-3"><input asp-for="IsActive"/> Đang bán</label></div></div><label asp-for="SampleText">Trang đọc thử</label><textarea asp-for="SampleText" class="form-control" rows="10" placeholder="Nội dung trang 1&#10;---PAGE---&#10;Nội dung trang 2"></textarea><p class="muted">Tách trang bằng một dòng ---PAGE---. Chỉ đăng nội dung có quyền sử dụng.</p><button class="btn btn-forest">Lưu sách</button><a class="btn" href="/Admin/Books">Quay lại</a></form><div class="row mt-4"><form class="col-md-6" asp-action="AddLookup" method="post"><h5>Thêm tác giả</h5><input type="hidden" name="kind" value="author"/><input name="name" required maxlength="150" class="form-control"/><button class="btn btn-outline-forest mt-2">Thêm</button></form><form class="col-md-6" asp-action="AddLookup" method="post"><h5>Thêm nhà xuất bản</h5><input type="hidden" name="kind" value="publisher"/><input name="name" required maxlength="150" class="form-control"/><button class="btn btn-outline-forest mt-2">Thêm</button></form></div>
