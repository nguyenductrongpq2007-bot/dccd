@model List<Category>
@{ViewData["Title"]="Quản lý danh mục";}<partial name="_AdminNav"/><h1>Quản lý danh mục</h1><form class="panel mb-4" asp-action="SaveCategory" method="post"><label for="new-name">Danh mục mới</label><div class="d-flex gap-2"><input id="new-name" class="form-control" name="name" required maxlength="100"/><button class="btn btn-forest">Thêm</button></div></form>@foreach(var c in Model){<div class="category-row"><form asp-action="SaveCategory" method="post"><input name="id" value="@c.Id" type="hidden"/><input aria-label="Tên danh mục" class="form-control" name="name" value="@c.Name" required maxlength="100"/><button class="btn btn-outline-forest">Lưu</button></form><form asp-action="DeleteCategory" method="post" data-confirm="Xóa danh mục này?"><input name="id" value="@c.Id" type="hidden"/><button class="btn btn-outline-danger">Xóa</button></form></div>}
