@model List<CartLine>
@{ViewData["Title"]="Giỏ hàng";var total=Model.Sum(x=>x.Total);var shipping=total>=300000||total==0?0:30000;var invalid=Model.Any(x=>!x.Book.IsActive||x.Book.Stock<x.Quantity);var recommended=(List<Book>)ViewBag.Recommended;}
<nav class="breadcrumb-custom"><a href="/">Trang chủ</a><span> / Giỏ hàng</span></nav><div class="section-heading"><h1>Giỏ hàng của bạn</h1><a href="/#catalog">← Tiếp tục chọn sách</a></div><p class="muted">@Model.Sum(x=>x.Quantity) cuốn sách đang chờ bạn.</p>@if(Model.Count==0){<div class="empty"><h3>Giỏ hàng còn trống</h3><p>Tìm một cuốn sách bạn muốn mang về nhà.</p><a class="btn btn-forest" href="/">Khám phá sách →</a></div>}else{<div class="cart-toolbar"><span>Kiểm tra số lượng và giá trước khi đặt</span><form asp-action="Clear" method="post" data-confirm="Xóa toàn bộ sách khỏi giỏ hàng?"><button type="submit" class="text-button">Xóa toàn bộ giỏ</button></form></div><div class="checkout-grid"><div>@foreach(var l in Model){<article class="cart-item"><img src="@l.Book.ImagePath" alt="@l.Book.Title"/><div><a href="/Books/Details/@l.Book.Id"><h5>@l.Book.Title</h5></a><p>@l.Book.Author.Name</p><strong>@l.Book.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</strong>@if(!l.Book.IsActive||l.Book.Stock<l.Quantity){<p class="text-danger">Sách không còn đủ hàng. Vui lòng cập nhật giỏ.</p>}</div><form asp-action="Update" method="post"><input type="hidden" name="id" value="@l.Book.Id"/><label class="visually-hidden" for="quantity-@l.Book.Id">Số lượng</label><div class="quantity-stepper cart-stepper"><button type="button" data-quantity-step="-1" aria-label="Giảm số lượng @l.Book.Title">−</button><input id="quantity-@l.Book.Id" type="number" name="quantity" value="@l.Quantity" min="0" max="@Math.Min(20,Math.Max(0,l.Book.Stock))"/><button type="button" data-quantity-step="1" aria-label="Tăng số lượng @l.Book.Title">+</button></div><button class="btn btn-sm btn-outline-forest">Cập nhật</button><button class="text-button text-danger" name="quantity" value="0" type="button" data-remove> Xóa</button></form><strong>@l.Total.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</strong></article>}</div><aside class="summary"><h4>Tóm tắt đơn hàng</h4>
@if(total < 300000){<div class="shipping-progress"><p>Thêm <strong>@((300000-total).ToString("N0", CultureInfo.GetCultureInfo("vi-VN")))đ</strong> để được miễn phí giao hàng</p><progress value="@total" max="300000" aria-label="Giá trị đơn so với mức miễn phí giao hàng"></progress><a href="/#catalog">Chọn thêm sách →</a></div>}else{<div class="free-shipping-note">✓ Đơn hàng được miễn phí giao hàng</div>}
<p>Tạm tính <b>@total.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</b></p><p>Phí giao hàng <b>@shipping.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))đ</b></p><hr/><p class="grand-total">Tổng cộng <b>@((total+shipping).ToString("N0", CultureInfo.GetCultureInfo("vi-VN")))đ</b></p>@if(invalid){<p class="field-error">Cập nhật số lượng hoặc bỏ sách không còn đủ hàng trước khi thanh toán.</p><button class="btn btn-forest w-100" disabled>Kiểm tra lại giỏ hàng</button>}else{<a href="/Orders/Checkout" class="btn btn-forest w-100">Tiến hành đặt hàng →</a>}<p class="muted mt-3">Thanh toán khi nhận hàng.<br/>Miễn phí giao hàng từ 300.000đ.</p></aside></div>}

@if(recommended.Count>0){<section class="shelf-section" data-cart-refresh><div class="section-heading"><div><span class="eyebrow">CHỌN THÊM MỘT CUỐN HAY</span><h2>Có thể bạn muốn đọc</h2></div><a href="/#catalog">Khám phá thêm →</a></div><div class="book-grid shelf-grid">@foreach(var b in recommended){<partial name="_BookCard" model="b" />}</div></section>}
